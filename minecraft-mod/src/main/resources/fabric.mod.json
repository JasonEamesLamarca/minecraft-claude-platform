{
  "schemaVersion": 1,
  "id": "mcai",
  "version": "${version}",
  "name": "Minecraft AI Platform",
  "description": "Server-side bridge between Minecraft and the Minecraft AI Platform gateway (/ai commands). No client mod needed.",
  "authors": ["Minecraft AI Platform contributors"],
  "contact": { "sources": "https://github.com/JasonEamesLamarca/minecraft-claude-platform" },
  "license": "Apache-2.0",
  "environment": "server",
  "entrypoints": {
    "server": ["dev.mcai.mod.McaiMod"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api-base": "*",
    "fabric-command-api-v2": "*",
    "fabric-lifecycle-events-v1": "*"
  }
}
