# Settings for compose.yaml. scripts/setup.sh copies this to .env and fills it in - run that instead
# of editing by hand. Never commit .env. Secrets do NOT go here: they live in secrets/ (also git-ignored).

# --- Written by setup.sh ---
# TRUE only after you accept https://www.minecraft.net/eula
MC_EULA=FALSE
# containers run as this host user, not root
PUID=
PGID=
# owner's Minecraft username: whitelisted + operator
MC_OWNER=
# none | api-key | subscription (credential in secrets/)
AI_AUTH_METHOD=none

# --- Minecraft ---
MC_TYPE=FABRIC
MC_VERSION=1.21.1
MC_FABRIC_LOADER_VERSION=0.20.1
# Modrinth "project:versionId", comma-separated
MC_MODS=fabric-api:Mys3P7lK
MC_PORT=25565
MC_BIND_ADDRESS=0.0.0.0
# Java heap
MC_MEMORY=4G
# container limit (setup.sh: heap + ~50%)
MC_MEM_LIMIT=7g
MC_CPUS=2.0
# Extra JVM flags (ZGC suits servers with 4G+ heap)
MC_JVM_XX_OPTS=-XX:+UseZGC -XX:+ZGenerational
# keep true: only real Minecraft accounts
MC_ONLINE_MODE=true
MC_WHITELIST=true
MC_LEVEL=world
MC_MOTD=Minecraft AI Platform
MC_DIFFICULTY=normal
MC_MAX_PLAYERS=10
MC_VIEW_DISTANCE=10
TZ=UTC

# --- Storage ---
MC_DATA_DIR=./data/minecraft
BACKUP_DIR=./backups

# --- Backups (itzg/mc-backup) ---
BACKUP_INTERVAL=24h
BACKUP_INITIAL_DELAY=10m
BACKUP_PRUNE_DAYS=14
BACKUP_PAUSE_IF_NO_PLAYERS=true

# --- Server mod (/ai commands) ---
# Command name; change it if another mod already uses /ai
MCAI_COMMAND=ai
# Minimum vanilla permission level for /ai (0 = every whitelisted player)
MCAI_ASK_PERMISSION_LEVEL=0
# Allow /ai ask from the server console (replies go to the server log)
MCAI_ALLOW_CONSOLE=true
MCAI_MOD_DIR=./dist/mod
# Tag for the locally built gateway and AI worker images
MCAI_VERSION=dev

# --- AI (gateway + worker) ---
# claude = real Claude Code; mock = canned answers for testing (no cost, no credential)
AI_PROVIDER=claude
# Optional model alias or full name (empty = Claude Code default)
AI_MODEL=
# Hard spending caps: per request (passed to claude --max-budget-usd) and per UTC day (0 disables the AI)
AI_MAX_REQUEST_USD=0.25
AI_DAILY_BUDGET_USD=2.00
AI_PLAYER_REQUESTS_PER_MINUTE=3
AI_MAX_PENDING_PER_PLAYER=1
AI_MAX_QUEUE=20
AI_MAX_CONCURRENT_JOBS=2
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MAX_PROMPT_CHARS=500
AI_MAX_REPLY_CHARS=1200
AI_WORKER_MEM_LIMIT=1g
# Store players' request text in the audit log (default: only length + hash)
AUDIT_LOG_TEXT=false
GATEWAY_DATA_DIR=./data/gateway

# --- AI builds (/ai build -> preview -> /ai approve -> /ai undo) ---
# Minimum vanilla permission level to use /ai build (4 = owner/console; ops are reset to the owner at start)
AI_BUILD_MIN_OP_LEVEL=4
# Spending cap and tool turns per build design
AI_MAX_BUILD_USD=1.00
AI_BUILD_MAX_TURNS=10
AI_BUILD_TIMEOUT_SECONDS=420
# Unapproved proposals expire after this many seconds
AI_APPROVE_TTL_SECONDS=900
# Size limits: blocks placed, bounding box, and max horizontal distance from the player
AI_BUILD_MAX_BLOCKS=40000
AI_BUILD_MAX_X=48
AI_BUILD_MAX_Y=64
AI_BUILD_MAX_Z=48
AI_BUILD_MAX_DISTANCE=64
# Blocks placed per server tick (20 ticks/s); lower it if builds make the server lag
MCAI_BLOCKS_PER_TICK=2000
