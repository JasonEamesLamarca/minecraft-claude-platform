# Copy to .env (scripts/setup.sh will do this and fill in generated values).
# Never commit .env. Every value here is a placeholder.

# --- Minecraft ---
# You must read and accept https://www.minecraft.net/eula ; the setup wizard asks you explicitly.
MC_EULA=FALSE
MC_VERSION=1.21.1
MC_TYPE=FABRIC
MC_MEMORY=4G
MC_PORT=25565
MC_ONLINE_MODE=true
MC_WHITELIST=true
TZ=UTC

# --- Internal service secrets (generated by setup.sh; leave empty here) ---
RCON_PASSWORD=
GATEWAY_MOD_TOKEN=

# --- AI authentication: choose ONE (setup.sh asks) ---
# a) Anthropic API key, pay per use; recommended for unattended use
ANTHROPIC_API_KEY=
# b) Claude subscription token from `claude setup-token`; check your plan's terms
CLAUDE_CODE_OAUTH_TOKEN=

# --- AI limits ---
AI_DAILY_TOKEN_BUDGET=200000
AI_MAX_CONCURRENT_JOBS=2
AI_REQUEST_TIMEOUT_SECONDS=600

# --- SSH management gateway ---
SSH_PORT=2222
